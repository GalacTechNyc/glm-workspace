# Z.ai API key (https://z.ai). Coding Plan keys work on the default endpoint.
ZAI_API_KEY=your-key-here
PORT=5173
# Optional: image generation (generate_image tool)
# OPENAI_API_KEY=
# Optional: video generation via Atlas Cloud (generate_video tool)
# ATLASCLOUD_API_KEY=
# Optional extra web search providers
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# Optional: github_api tool (fine-grained PAT; Contents RW is enough for repos)
# GITHUB_TOKEN=
# Optional: run_command tool — the ONLY binaries GLM may execute (no shell, plain args).
# Keep the list short and specific; leave empty to disable the tool entirely.
# COMMAND_ALLOWLIST=curl,dig,whois,nmap,httpx,subfinder,nuclei,ffuf,git
# Optional: MCP servers (streamable HTTP), name=url pairs, comma-separated.
# Their tools become callable via mcp_list / mcp_call.
# MCP_SERVERS=example=https://mcp.example.com/mcp,tools=https://api.z.ai/api/mcp/web_search_prime/mcp
